[Unit]
Description=carrydesk API (Hyperliquid funding carry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/carrydesk
EnvironmentFile=%h/carrydesk/.env
# --proxy-headers + --forwarded-allow-ips so the app sees the real external
# scheme and host behind Caddy. x402 embeds the resource URL in the payment
# challenge; without this it would advertise http://127.0.0.1:8000 to buyers.
ExecStart=%h/carrydesk/.venv/bin/python -m uvicorn carrydesk.api:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=10

# This co-exists with a real-money trading bot on the same box. A memory ceiling
# is not optional: carrydesk must never be able to starve other-services.service.
MemoryMax=512M
CPUWeight=50

# One worker on purpose: the snapshot store is in-process memory and the
# background refresher must not run N times against Hyperliquid. Scale with a
# reverse proxy and caching, not with workers.

StandardOutput=append:%h/carrydesk/carrydesk.log
StandardError=append:%h/carrydesk/carrydesk.log

[Install]
WantedBy=default.target
