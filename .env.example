# Copy to .env and fill in. Never commit .env.

# --- Payments ---------------------------------------------------------------
# Receiving wallet. Leave BLANK to run fully open with no paywall (dev default).
X402_PAY_TO=

# eip155:84532 = Base Sepolia (testnet), public facilitator, no credentials needed.
# eip155:8453  = Base mainnet USDC, needs a CDP facilitator + API keys.
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Pricing ----------------------------------------------------------------
PRICE_RANKINGS=$0.05
PRICE_HISTORY=$0.02
PRICE_UNIVERSE=$0.01

# --- Service ----------------------------------------------------------------
PUBLIC_URL=http://localhost:8000
REFRESH_SECONDS=3600
