# Copy to .env and fill in. Never commit .env.

# --- Payments ---------------------------------------------------------------
# Receiving wallet. Leave BLANK to run fully open with no paywall (dev default).
X402_PAY_TO=

# eip155:84532 = Base Sepolia (testnet), public facilitator, no credentials needed.
# eip155:8453  = Base mainnet USDC, needs a CDP facilitator + API keys.
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Pricing ----------------------------------------------------------------
PRICE_RANKINGS=$0.05
PRICE_HISTORY=$0.02
PRICE_UNIVERSE=$0.01

# --- Service ----------------------------------------------------------------
PUBLIC_URL=http://localhost:8000
REFRESH_SECONDS=3600

# --- Monitoring (optional) --------------------------------------------------
# File containing TELEGRAM_BOT_TOKEN=... and the chat to alert. Without these,
# cron_check.sh logs to alert.log instead of paging. Never commit either value.
HERMES_ENV=
TELEGRAM_CHAT_ID=

# --- Archive push (server only) ---------------------------------------------
# SSH deploy key with WRITE access, used by cron_archive.sh. Unset = use
# whatever git/ssh is already configured.
CARRYDESK_DEPLOY_KEY=
