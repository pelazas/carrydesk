# Copy to .env and fill in. Never commit .env.

# --- Payments ---------------------------------------------------------------
# Receiving wallet. Leave BLANK to run fully open with no paywall (dev default).
X402_PAY_TO=

# eip155:84532 = Base Sepolia (testnet). Public facilitator, no credentials.
# eip155:8453  = Base mainnet USDC. Requires the CDP keys below; the facilitator
#                URL switches automatically, so this is the only var to change.
X402_NETWORK=eip155:84532

# Only for mainnet. Create at https://cdp.coinbase.com -> project -> API keys.
# The service refuses to start on mainnet without them rather than serving
# payment challenges it cannot settle.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Override only if you run your own facilitator.
# X402_FACILITATOR_URL=

# --- Pricing ----------------------------------------------------------------
PRICE_RANKINGS=$0.05
PRICE_HISTORY=$0.02
PRICE_UNIVERSE=$0.01

# --- Service ----------------------------------------------------------------
PUBLIC_URL=http://localhost:8000
REFRESH_SECONDS=3600

# --- Monitoring (optional) --------------------------------------------------
# File containing TELEGRAM_BOT_TOKEN=... and the chat to alert. Without these,
# cron_check.sh logs to alert.log instead of paging. Never commit either value.
HERMES_ENV=
TELEGRAM_CHAT_ID=

# --- Archive push (server only) ---------------------------------------------
# SSH deploy key with WRITE access, used by cron_archive.sh. Unset = use
# whatever git/ssh is already configured.
CARRYDESK_DEPLOY_KEY=
